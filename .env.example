# Supabase > Connect > Transaction pooler (puerto 6543).
# Es la conexión recomendada para funciones serverless de Vercel.
DATABASE_URL=postgres://postgres.PROJECT_REF:PASSWORD@aws-REGION.pooler.supabase.com:6543/postgres?sslmode=require

# Se usan para firmar identificadores internos sin exponer datos sensibles.
PIGNUS_SESSION_SECRET=replace-with-at-least-32-random-characters
PIGNUS_RATE_LIMIT_SECRET=replace-with-another-random-secret

