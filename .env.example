# Supabase > Connect > Transaction pooler (puerto 6543).
# Es la conexión recomendada para funciones serverless de Vercel.
DATABASE_URL=postgres://postgres.PROJECT_REF:PASSWORD@aws-REGION.pooler.supabase.com:6543/postgres?sslmode=require

# Se usan para firmar identificadores internos sin exponer datos sensibles.
PIGNUS_SESSION_SECRET=replace-with-at-least-32-random-characters
PIGNUS_RATE_LIMIT_SECRET=replace-with-another-random-secret

# Tickets: configurar el buzón desde Administración > Configuración > Tickets.
# Clave dedicada opcional (al menos 32 caracteres aleatorios). Si está vacía,
# se deriva la clave de cifrado desde PIGNUS_SESSION_SECRET mediante HKDF.
# Mantener la misma clave en la API y en el worker. Leer docs/TICKETS.md antes de rotarla.
TICKETS_MAIL_ENCRYPTION_KEY=

# Secreto dedicado opcional para la ejecución automática (al menos 32 caracteres aleatorios).
# Si se omite, se deriva de PIGNUS_SESSION_SECRET mediante HKDF con contexto propio.
# Si se define explícitamente vacío o con menos de 32 caracteres, se rechaza.
# POST /api/tickets/mail/process con Authorization: Bearer <secreto>.
# El programador de Supabase guarda la credencial en Vault. Debe coincidir con la API.
# Configurar con npm run mail:tickets:schedule; definir la variable no crea la tarea.
# Si cambia este secreto o su clave de origen, repetir --prepare y --enable.
# No confundirlo con la contraseña del buzón. Ver docs/TICKETS.md para operación y rotación.
# TICKETS_MAIL_WORKER_SECRET=

# Compatibilidad: configuración por entorno antes de guardar el canal en Agentec.
# La configuración guardada en la base prevalece; guardar deja el canal pausado.
# Usar un buzón o carpeta aislada con copias durante las pruebas y convivencia con Zammad.
TICKETS_MAIL_ENABLED=false
TICKETS_MAIL_MODE=test
TICKETS_MAIL_TEST_SOURCE_CONFIRMED=false
TICKETS_MAIL_ADDRESS=soporte@pignusarg.com
TICKETS_MAIL_USER=
TICKETS_MAIL_PASSWORD=
TICKETS_MAIL_FOLDER=INBOX
TICKETS_MAIL_IMAP_HOST=imap.secureserver.net
TICKETS_MAIL_SMTP_HOST=smtpout.secureserver.net
TICKETS_MAIL_BATCH_SIZE=25
TICKETS_MAIL_MAX_RUN_MS=45000

# Reservas de ventas: estimación en línea recta, sin proveedor de rutas.
# Velocidad referencial (km/h) y margen por traslado (minutos).
PIGNUS_SALES_ESTIMATE_KMH=25
PIGNUS_SALES_BUFFER_MINUTES=15

# Confirmaciones de instalación por WhatsApp vía GoHighLevel.
# Sólo variables de servidor; nunca usar el prefijo VITE_. Mantener desactivado
# hasta aprobar la plantilla, publicar el flujo y completar la prueba interna.
PIGNUS_GHL_ENABLED=false
PIGNUS_GHL_WEBHOOK_URL=

# Postventa de instalación: workflow distinto al de confirmación de visita.
PIGNUS_GHL_EXPERIENCE_ENABLED=false
PIGNUS_GHL_EXPERIENCE_WEBHOOK_URL=
